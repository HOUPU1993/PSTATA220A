library(tidyverse)
library(lubridate)
library(faraway)
library(carData)
library(sandwich)   # HC (EHW) covariance
library(lmtest)     # coeftest, bptest, dwtest, bgtest
library(ellipse)    # joint confidence region
knitr::opts_chunk$set(message = FALSE, warning = FALSE)
options(width = 80)
set.seed(220)
data(Salaries)
summary(Salaries)
cor(Salaries[, c("yrs.since.phd", "yrs.service", "salary")])
Salaries %>% group_by(rank) %>%
summarise(n = n(), mean = mean(salary), sd = sd(salary))
Salaries %>% group_by(sex) %>% summarise(n = n(), mean = mean(salary))
Salaries %>% group_by(discipline) %>% summarise(n = n(), mean = mean(salary))
p1 <- ggplot(Salaries, aes(rank, salary, fill = sex)) + geom_boxplot() +
labs(title = "Salary by rank and sex")
p2 <- ggplot(Salaries, aes(yrs.since.phd, salary, colour = rank)) +
geom_point(alpha = .6) + labs(title = "Salary vs years since PhD")
p3 <- ggplot(Salaries, aes(yrs.since.phd, yrs.service)) + geom_point(alpha = .5) +
labs(title = "Years since PhD vs years of service")
p4 <- ggplot(Salaries, aes(discipline, salary)) + geom_boxplot() +
labs(title = "Salary by discipline (A = theoretical, B = applied)")
gridExtra::grid.arrange(p1, p2, p3, p4, ncol = 2)
fit <- lm(salary ~ rank + discipline + yrs.since.phd + yrs.service + sex, data = Salaries)
summary(fit)
X <- model.matrix(fit)
y <- Salaries$salary
beta_hat <- solve(t(X) %*% X, t(X) %*% y)       # (X'X)^{-1} X'y
cbind(matrix = drop(beta_hat), lm = coef(fit))
all.equal(drop(beta_hat), coef(fit), check.attributes = FALSE)
c(R2 = summary(fit)$r.squared, adjR2 = summary(fit)$adj.r.squared)
i_max <- which.max(abs(resid(fit)))
i_max; resid(fit)[i_max]
Salaries[i_max, ]
confint(fit, c("yrs.since.phd", "yrs.service"), level = 0.99)
idx <- c("yrs.since.phd", "yrs.service")
cr <- ellipse(fit, which = idx, level = 0.95)
ci <- confint(fit, idx, level = 0.95)
plot(cr, type = "l", xlab = idx[1], ylab = idx[2],
main = "95% joint confidence region")
points(coef(fit)[idx[1]], coef(fit)[idx[2]], pch = 19)
abline(v = ci[1, ], h = ci[2, ], lty = 2, col = "grey40")
abline(h = 0, v = 0, col = "red", lty = 3)
cov2cor(vcov(fit))[idx, idx]
grid <- tibble(yrs.since.phd = 6:50) %>%
mutate(yrs.service = yrs.since.phd - 5,
rank = factor("Prof", levels(Salaries$rank)),
discipline = factor("B", levels(Salaries$discipline)),
sex = factor("Male", levels(Salaries$sex)))
p  <- length(coef(fit)); dfr <- df.residual(fit); m <- nrow(grid)
Xg <- model.matrix(delete.response(terms(fit)), grid,
contrasts.arg = attr(model.matrix(fit), "contrasts"))
fitv  <- drop(Xg %*% coef(fit))
se_mu <- sqrt(rowSums((Xg %*% vcov(fit)) * Xg))          # SE of mean response
se_pr <- sqrt(se_mu^2 + summary(fit)$sigma^2)            # SE of new observation
q_pt  <- qt(0.975, dfr)                                  # pointwise
q_sch <- sqrt(p * qf(0.95, p, dfr))                      # Scheffe (mean)
q_bon <- qt(1 - 0.05 / (2 * m), dfr)                     # Bonferroni (prediction)
bands <- grid %>% mutate(fit = fitv,
mean_pt_lo = fit - q_pt * se_mu,  mean_pt_hi = fit + q_pt * se_mu,
mean_sim_lo = fit - q_sch * se_mu, mean_sim_hi = fit + q_sch * se_mu,
pred_pt_lo = fit - q_pt * se_pr,  pred_pt_hi = fit + q_pt * se_pr,
pred_sim_lo = fit - q_bon * se_pr, pred_sim_hi = fit + q_bon * se_pr)
# sanity check vs predict()
all.equal(unname(bands$mean_pt_lo),
unname(predict(fit, grid, interval = "confidence")[, "lwr"]))
ggplot(bands, aes(yrs.since.phd)) +
geom_ribbon(aes(ymin = pred_sim_lo, ymax = pred_sim_hi,
fill = "Prediction, simultaneous"), alpha = .2) +
geom_ribbon(aes(ymin = pred_pt_lo, ymax = pred_pt_hi,
fill = "Prediction, pointwise"), alpha = .3) +
geom_ribbon(aes(ymin = mean_sim_lo, ymax = mean_sim_hi,
fill = "Mean, simultaneous"), alpha = .4) +
geom_ribbon(aes(ymin = mean_pt_lo, ymax = mean_pt_hi,
fill = "Mean, pointwise"), alpha = .6) +
geom_line(aes(y = fit)) +
labs(y = "salary", fill = NULL,
title = "95% bands (Prof, discipline B, male, service = PhD yrs - 5)") +
theme(legend.position = "bottom") + guides(fill = guide_legend(nrow = 2))
fit_red <- update(fit, . ~ . - yrs.since.phd)
partialR2 <- (deviance(fit_red) - deviance(fit)) / deviance(fit_red)
partialR2
# equivalently t^2 / (t^2 + df)
tval <- summary(fit)$coef["yrs.since.phd", "t value"]; tval^2 / (tval^2 + dfr)
se_tab <- cbind(OLS = sqrt(diag(vcov(fit))),
EHW_HC0 = sqrt(diag(vcovHC(fit, type = "HC0"))),
HC3 = sqrt(diag(vcovHC(fit, type = "HC3"))))
round(se_tab, 1)
round(se_tab[, "EHW_HC0"] / se_tab[, "OLS"], 2)
coeftest(fit, vcov. = vcovHC(fit, type = "HC0"))
bptest(fit)
ggplot(tibble(fitted = fitted(fit), resid = resid(fit), rank = Salaries$rank),
aes(fitted, resid, colour = rank)) + geom_point(alpha = .6) +
geom_hline(yintercept = 0) + labs(title = "Residuals vs fitted")
# parameters (change n to see how power depends on sample size)
n <- 10; mu <- 0; delta <- 2; sigma <- 1; B <- 10000; alpha <- 0.05
T_stat <- function(y) {
n <- length(y) - 1
(y[n + 1] - mean(y[1:n])) / (sd(y[1:n]) * sqrt(1 + 1 / n))
}
T_sim <- replicate(B, T_stat(c(rnorm(n, mu, sigma), rnorm(1, mu + delta, sigma))))
crit  <- qt(1 - alpha / 2, df = n - 1)
power_sim <- mean(abs(T_sim) > crit)
# exact power: T ~ noncentral t_{n-1} with ncp = delta / (sigma sqrt(1 + 1/n))
ncp <- delta / (sigma * sqrt(1 + 1 / n))
power_exact <- 1 - pt(crit, n - 1, ncp) + pt(-crit, n - 1, ncp)
c(simulated = power_sim, exact = power_exact)
# sanity check: T equals the lm t-statistic for delta
y_chk <- c(rnorm(n), rnorm(1, 2)); X2 <- cbind(1, c(rep(0, n), 1))
c(lm = summary(lm(y_chk ~ X2 - 1))$coef[2, "t value"], formula = T_stat(y_chk))
hist(T_sim, breaks = 60, freq = FALSE, main = "Simulated T under delta = 2 (n = 10)", xlab = "T")
curve(dt(x, n - 1, ncp), add = TRUE, col = "blue", lwd = 2)
curve(dt(x, n - 1), add = TRUE, col = "red", lty = 2, lwd = 2)
abline(v = c(-crit, crit), lty = 3)
legend("topright", c("noncentral t (H1)", "t (H0)"), col = c("blue", "red"), lty = 1:2, bty = "n")
# power as a function of n
sapply(c(5, 10, 30, 100, 1000), function(n) {
cr <- qt(.975, n - 1); nc <- 2 / sqrt(1 + 1 / n)
1 - pt(cr, n - 1, nc) + pt(-cr, n - 1, nc)
}) %>% setNames(c(5, 10, 30, 100, 1000))
sim_lm <- function(rerr, n = 20, beta = c(1, 0, 0.5), B = 5000, alpha = 0.05) {
X <- cbind(1, runif(n), rnorm(n))          # fixed design across replications
p <- ncol(X); XtXi <- solve(crossprod(X)); d <- sqrt(diag(XtXi))
q <- qt(1 - alpha / 2, n - p)
out <- replicate(B, {
y  <- drop(X %*% beta) + rerr(n)
f  <- lm.fit(X, y)
s  <- sqrt(sum(f$residuals^2) / (n - p))
c((f$coefficients - beta) / (s * d),     # pivot -> should be t_{n-p}
f$coefficients / (s * d))              # test statistic for H0: beta_j = 0
})
piv <- t(out[1:p, ]); tz <- t(out[(p + 1):(2 * p), ])
list(piv = piv, df = n - p,
ks_p     = apply(piv, 2, function(z) ks.test(z, "pt", df = n - p)$p.value),
coverage = colMeans(abs(piv) <= q),   # CI covers true beta_j
reject   = colMeans(abs(tz) > q))     # rejects H0: beta_j = 0
}
summ <- function(r) round(rbind(`KS p-value` = r$ks_p, coverage = r$coverage,
`P(reject H0: b=0)` = r$reject), 3) %>%
`colnames<-`(c("b0 = 1", "b1 = 0", "b2 = 0.5"))
err <- list(
Normal       = function(n) rnorm(n),
`t3 (heavy)` = function(n) rt(n, 3) / sqrt(3),   # symmetric, heavy-tailed, var 1
`Exp (skew)` = function(n) rexp(n) - 1           # skewed, mean 0, var 1
)
res_N <- sim_lm(err$Normal)
summ(res_N)
par(mfrow = c(1, 3))
for (j in 1:3) {
hist(res_N$piv[, j], breaks = 60, freq = FALSE, xlim = c(-5, 5),
main = bquote("Pivot for" ~ beta[.(j - 1)]), xlab = "")
curve(dt(x, res_N$df), add = TRUE, col = "red", lwd = 2)
}
par(mfrow = c(1, 1))
qqplot(qt(ppoints(5000), res_N$df), res_N$piv[, 2],
xlab = "t(17) quantiles", ylab = "simulated pivot", main = "QQ plot, Gaussian errors")
abline(0, 1, col = "red")
res_T <- sim_lm(err$`t3 (heavy)`)
res_E <- sim_lm(err$`Exp (skew)`)
summ(res_T); summ(res_E)
par(mfrow = c(1, 2))
for (r in list(list(res_T, "t3 errors"), list(res_E, "Exp errors"))) {
qqplot(qt(ppoints(5000), r[[1]]$df), r[[1]]$piv[, 1],
xlab = "t(17) quantiles", ylab = "pivot for b0", main = r[[2]])
abline(0, 1, col = "red")
}
par(mfrow = c(1, 1))
small <- lapply(err, sim_lm, n = 8)
lapply(small, summ)
data(divusa)
ggplot(divusa, aes(year, divorce)) +
geom_line(colour = "grey40") + geom_point(size = 1) +
geom_smooth(method = "loess", se = FALSE, span = .3, colour = "firebrick") +
annotate("rect", xmin = 1941, xmax = 1945, ymin = -Inf, ymax = Inf, alpha = .1) +
annotate("text", x = 1943, y = 7, label = "WWII", size = 3) +
labs(x = "Year", y = "Divorces per 1,000 married women aged 15+",
title = "U.S. divorce rate, 1920–1996")
fit4 <- lm(divorce ~ year + unemployed + femlab + marriage + birth + military, data = divusa)
summary(fit4)
e <- resid(fit4); nn <- length(e)
par(mfrow = c(1, 2))
plot(divusa$year, e, type = "b", pch = 20, xlab = "Year", ylab = "Residual",
main = "Residuals over time"); abline(h = 0, lty = 2)
plot(e[-nn], e[-1], pch = 20, xlab = expression(hat(e)[t]), ylab = expression(hat(e)[t + 1]),
main = "Lag-1 residual plot"); abline(h = 0, v = 0, lty = 2)
par(mfrow = c(1, 1))
cor(e[-nn], e[-1])
acf(e, main = "ACF of residuals")
dwtest(fit4)                 # H0: rho = 0  vs  H1: rho > 0
bgtest(fit4, order = 1)      # Breusch-Godfrey, robust to general regressors
