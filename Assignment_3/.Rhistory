pred_grid <- bind_cols(grid, as_tibble(predict(fit_wls, newdata = grid,
interval = "prediction", weights = 1 / grid$income)))
pred_obs <- bind_cols(teengamb, as_tibble(predict(fit_wls, newdata = teengamb,
interval = "prediction", weights = 1 / teengamb$income)))
ggplot() +
geom_ribbon(data = pred_grid, aes(income, ymin = lwr, ymax = upr), fill = "steelblue", alpha = 0.2) +
geom_line(data = pred_grid, aes(income, fit), color = "steelblue") +
geom_errorbar(data = pred_obs, aes(income, ymin = lwr, ymax = upr), width = 0.15, color = "grey50") +
geom_point(data = teengamb, aes(income, gamble)) +
labs(x = "Income (pounds per week)", y = "Gamble (pounds per year)",
title = "WLS fit with 95% prediction intervals (Var ~ income)")
