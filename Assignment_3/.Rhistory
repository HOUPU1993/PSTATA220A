# 1. Try adding squared terms to the AIC model
fit_sq <- step(fit_aic,
scope = ~ . + I(lcavol^2) + I(lweight^2) + I(age^2) + I(lbph^2),
trace = 0)
# 2. Try adding pairwise interactions among the variables in the AIC model
fit_int <- step(fit_aic, scope = ~ .^2, trace = 0)
formula(fit_sq)
formula(fit_int)
# 3. Compare the three models with AIC and 10-fold CV error (same folds as in part a)
cv_error <- function(fit) {
errs <- numeric(K)
for (k in 1:K) {
m    <- lm(formula(fit), data = prostate[folds != k, ])
test <- prostate[folds == k, ]
errs[k] <- mean((test$lpsa - predict(m, test))^2)
}
mean(errs)
}
models <- list(fit_aic, fit_sq, fit_int)
data.frame(model   = c("Main effects", "+ squared terms", "+ interactions"),
n_terms = sapply(models, \(m) length(coef(m)) - 1),
AIC     = sapply(models, AIC),
CV_MSE  = sapply(models, cv_error))
head(prostate)
# Model 1: main effects (the AIC model from part a)
fit_main <- fit_aic
# Model 2: main effects + squared terms
fit_sq <- lm(lpsa ~ lcavol + lweight + age + lbph + svi +
I(lcavol^2) + I(lweight^2) + I(age^2) + I(lbph^2), data = prostate)
# Model 3: main effects + all pairwise interactions
fit_int <- lm(lpsa ~ (lcavol + lweight + age + lbph + svi)^2, data = prostate)
data.frame(model   = c("Main effects", "+ squared terms", "+ interactions"),
n_terms = c(length(coef(fit_main)), length(coef(fit_sq)), length(coef(fit_int))) - 1,
AIC     = round(c(AIC(fit_main), AIC(fit_sq), AIC(fit_int)), 2))
final <- fit_main
summary(final)
