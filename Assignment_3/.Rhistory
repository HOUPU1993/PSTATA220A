If $\text{Var}(\epsilon_i) = \sigma^2 \cdot \text{income}_i$, the weights are $w_i = 1/\text{income}_i$.
fit_wls <- lm(gamble ~ income, data = teengamb, weights = 1 / income)
wls_tab <- cbind(Estimate = coef(fit_wls), confint(fit_wls))
knitr::kable(wls_tab, digits = 3, caption = "WLS estimates and 95% confidence intervals")
fit_wls <- lm(gamble ~ income, data = teengamb, weights = 1 / income)
make_tab <- function(fit, model) {
tibble(Model = model,
Term = names(coef(fit)),
Estimate = coef(fit),
SE = summary(fit)$coefficients[, 2],
`2.5 %` = confint(fit)[, 1],
`97.5 %` = confint(fit)[, 2])
}
bind_rows(make_tab(fit_ols, "OLS"), make_tab(fit_wls, "WLS")) |>
knitr::kable(digits = 3, caption = "OLS and WLS estimates with 95% confidence intervals")
