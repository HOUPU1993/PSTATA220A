fit_ols <- lm(gamble ~ income, data = teengamb)
tibble(fitted = fitted(fit_ols),
`Residual` = residuals(fit_ols),
`sqrt(|Residual|)` = sqrt(abs(residuals(fit_ols)))) |>
pivot_longer(-fitted, names_to = "panel") |>
ggplot(aes(fitted, value)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE, formula = y ~ x) +
facet_wrap(~ panel, scales = "free_y") +
labs(x = "Fitted value", y = NULL, title = "OLS residual diagnostics")
# Regress sqrt(|e|) on fitted values (Faraway's check)
aux <- lm(sqrt(abs(residuals(fit_ols))) ~ fitted(fit_ols))
aux_tab <- summary(aux)$coefficients
# Breusch-Pagan test
bp <- lmtest::bptest(fit_ols)
